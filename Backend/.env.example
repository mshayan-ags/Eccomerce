# Copy this file to .env and fill in real values. Never commit the real .env.

# MongoDB connection string, e.g. mongodb://127.0.0.1:27017/Eccomerce
# or a mongodb+srv:// Atlas URI.
MONGODB_URI=mongodb://127.0.0.1:27017/Eccomerce

# Random secret used to sign JWTs. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret

# Stripe secret key (test mode key from the Stripe dashboard, starts with sk_test_).
# Never hardcode this in source.
STRIPE_SECRET_KEY=sk_test_replace_me

# Signing secret for the /Stripe-Webhook endpoint, from the Stripe dashboard's
# webhook config (or `stripe listen` output in local dev). Starts with whsec_.
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Comma-separated list of origins allowed to call this API.
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

PORT=5000

# Optional SMTP config used to email password-reset OTPs.
# If left unset, OTPs are logged to the server console instead (dev fallback).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Eccomerce <no-reply@example.com>"
